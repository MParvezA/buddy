<?xml version="1.0"?>
<sdf version="1.9">
  <world name="buddy_smoke">
    <physics name="deterministic" type="dart"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.1 0.1 0.1 1</background></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></visual></link></model>
    <include><uri>model://buddy</uri><pose>0 0 0 0 0 0</pose></include>
    <model name="smoke_obstacle"><static>true</static><pose>2 0 0.3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 0.8 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 0.8 0.6</size></box></geometry></visual></link></model>
  </world>
</sdf>
